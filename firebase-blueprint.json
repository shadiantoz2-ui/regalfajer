{
  "entities": {
    "StaffAccount": {
      "title": "StaffAccount",
      "description": "Authorized teacher or admin account record managed by administrators with username/password authentication.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Display name of the teacher or admin"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 150,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "description": "Normalized internal login email (<username>@rijal-alfajr.app)"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "teacher"],
          "description": "Staff access role"
        },
        "uid": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "description": "Bound Firebase Auth UID"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "active"],
          "description": "Whether the staff account is active"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the account was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the account was last updated"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of the admin who created this account"
        }
      },
      "required": ["name", "email", "role", "uid", "status", "createdAt", "updatedAt", "createdByUid"]
    },
    "StaffProfile": {
      "title": "StaffProfile",
      "description": "Active UID-keyed staff profile used by security rules for instant RBAC lookup.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 150,
          "description": "Normalized login email address"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "teacher"],
          "description": "Authoritative role"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["uid", "email", "name", "role", "createdAt", "updatedAt"]
    },
    "BootstrapConfig": {
      "title": "BootstrapConfig",
      "description": "One-time immutable initialization marker recording the primary admin UID.",
      "type": "object",
      "properties": {
        "initialized": {
          "type": "boolean",
          "description": "True once the initial admin account has been created"
        },
        "adminUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the primary admin"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        }
      },
      "required": ["initialized", "adminUid", "createdAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Registered student participating in Fajr attendance.",
      "type": "object",
      "properties": {
        "full_name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Cleaned Arabic display name"
        },
        "normalized_name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Normalized Arabic name used for duplicate prevention and fuzzy matching"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of the staff member who registered the student"
        }
      },
      "required": ["full_name", "normalized_name", "createdAt", "updatedAt", "createdByUid"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily attendance record for a student, keyed deterministically by date and student ID.",
      "type": "object",
      "properties": {
        "student_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Referenced student document ID"
        },
        "student_name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Student display name at check-in time"
        },
        "attended_on": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Local attendance date (YYYY-MM-DD)"
        },
        "recorded_by_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of the teacher or admin who recorded this attendance"
        },
        "recorded_by_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Name of the teacher or admin who recorded this attendance"
        },
        "recorded_by_email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 150,
          "description": "Email/login of the teacher or admin who recorded this attendance"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when attendance was recorded"
        }
      },
      "required": [
        "student_id",
        "student_name",
        "attended_on",
        "recorded_by_uid",
        "recorded_by_name",
        "recorded_by_email",
        "createdAt"
      ]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Global application visibility settings.",
      "type": "object",
      "properties": {
        "results_public": {
          "type": "boolean",
          "description": "Whether public attendance leaderboard is visible"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of the admin who updated settings"
        }
      },
      "required": ["results_public", "updatedAt", "updatedByUid"]
    },
    "PublicResults": {
      "title": "PublicResults",
      "description": "Public leaderboard summary document containing only student display names and day counts.",
      "type": "object",
      "properties": {
        "results_public": {
          "type": "boolean",
          "description": "Whether the snapshot is publicly readable"
        },
        "rows": {
          "type": "array",
          "description": "Aggregated student attendance day counts"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of the staff member who updated the snapshot"
        }
      },
      "required": ["results_public", "rows", "updatedAt", "updatedByUid"]
    },
    "AssistantChat": {
      "title": "AssistantChat",
      "description": "Saved AI assistant conversation history for an admin user.",
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Owner admin UID"
        },
        "messages": {
          "type": "array",
          "description": "Saved UIMessage conversation entries"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["user_id", "messages", "updatedAt"]
    }
  },
  "firestore": {
    "/staff_accounts/{accountId}": {
      "schema": { "$ref": "#/entities/StaffAccount" },
      "description": "Admin-managed teacher and admin accounts indexed by normalized login email key"
    },
    "/staff_profiles/{userId}": {
      "schema": { "$ref": "#/entities/StaffProfile" },
      "description": "Active UID-keyed staff roles and display profiles"
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Student roster for Fajr prayer attendance"
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/Attendance" },
      "description": "Daily student attendance records with teacher attribution"
    },
    "/app_settings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Global settings (/app_settings/global) and one-time bootstrap marker (/app_settings/bootstrap)"
    },
    "/public_results/{docId}": {
      "schema": { "$ref": "#/entities/PublicResults" },
      "description": "Public leaderboard summary (/public_results/latest)"
    },
    "/assistant_chats/{userId}": {
      "schema": { "$ref": "#/entities/AssistantChat" },
      "description": "Per-admin assistant chat history"
    }
  }
}
